android_app {
    name: "SetupWizard2",
    srcs: ["java/**/*.kt"],
    resource_dirs: ["res"],
	asset_dirs: ["assets"],
    manifest: "AndroidManifest.xml",

    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    platform_apis: true,

    overrides: ["Provision"],

    static_libs: [
        "androidx.core_core",
        "setupcompat",
        "setupdesign",
    ],

    required: ["etc_permissions_app.mosaicos.setupwizard"],
}

prebuilt_etc {
    name: "etc_permissions_app.mosaicos.setupwizard",
    src: "etc/permissions/app.mosaicos.setupwizard.xml",
    sub_dir: "permissions",
    filename_from_src: true,
    system_ext_specific: true,
}
